<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="main.css">
    <link rel="icon" type="image/icon" href="resources/sysco.png">
    <style>
        #scams{
            width: 40em;
            margin: 1rem auto 0;
            border-radius: 1em;
        }
        #scams video{
            transform: scaleX(-1);
            
            border-radius: 1em;
            
        }
        @media (max-width: 40em){
            #scams,
            #scams video{
                width: 100%;
                max-width: 100%;
            }
        }
        .descision{
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background-color: #000a1d;
            padding: 20px;
            width:100%;
            height:100%;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.3);
        }
        .descision h1{
            font-size: 4em;
            margin-bottom: 10px;
        }
        .descision h2{
            font-size: 2.5em;
            margin-bottom: 10px;
        }
        .rej{
            display: none;
            background: linear-gradient(145deg, rgba(255,0,0,1) 0%, rgb(29, 0, 0) 100%);
        }
        .accept{
            display: none;
            background: linear-gradient(145deg, rgb(0, 206, 0) 0%, rgb(0, 29, 0) 100%);
        }
        .inform{
            filter: brightness(0) invert(1);
            width: 100px;
        }
        .anim{
            position: absolute;
            top:0;
            width: 100%;
            height:0.4em;
            padding:0;
            margin:0;
            box-sizing:border-box;
            left:0;
        }
        .loader{
            height:100%;
            background:fixed linear-gradient(90deg,  rgba(255,255,255,0.1)  0%, rgb(255, 255, 255) 100%);
            animation: loading 5s linear infinite;
        }
        @keyframes loading {
            0% { transform: translateX(-100%); }
            100% { transform: translateX(100%); }
        }
        .top{
            display:flex;
            justify-content:space-between;
            width:100%;
            font-size:1.5em;
            color:#E6FDFF;
        }
        select{
            width:20em;
            padding:0.5em;
            font-size:1.2em;
            border-radius:1em;
            background-color:#031A54;
            color:#E6FDFF;
            border:1.5px solid #E6FDFF;
            margin-block:1em;
        }
        a{
            color:#E6FDFF;
            font-size:1.2em;
            line-height:1.5em;
        }
        .dashi{
            display:inline-block;
            text-decoration:none;
            border-radius:0.4em;
            border:1px solid #E6FDFF;
            padding:0.2em 0.4em;
            margin-top:0.4em;
        }
        .personname{
            line-height:1em;
            margin:0;
        }
        #accdetails,#rejdetails{
            font-size:1.5em;
            font-weight: 400;
            line-height:1em;
            margin:0;}
    </style>
</head>
<body>
    <div class="maine">
        <img src="resources/syscot.png" class="infom">
        <hr>
        <span style="display:none;" id="username"><%=locals.username || "N/A"%></span>
        <h1 id="eventname"><%= locals.event_name %></h1>
        <p id="date"></p>
        <a class="dashi" href="/dashboard">Back to Dashboard</a>
    </div>
    <div class="center">
        <h1>Scan Participant QR</h1>
        <select id="session" required>
            <option disabled value="--Choose a Session--">--Choose a Session--</option>
            <% (locals.sessions || []).forEach(function(session) { %>
                <option value="<%= session.id %>"><%= session.name %></option>
            <% }); %>
        </select>
        <div id="scams"></div>
        <div class="holder">
            <a href="/markmanual">Manual Check-In</a>
        </div>
    </div>
    <div class="rej descision" id="rejection">
        <div class="anim">
            <div class="loader"></div>
        </div>
        <div class="top">
            <span id="chkname"></span>
            <span class="lef">Check-In</span>
        </div>
        <img class="inform" src="data:image/svg+xml;base64," alt="denied">
        <h1 id="demnal">Already Checked In</h1>
        <hr>
        <h2 class="personname" id="rejname">John Cena</h2>
        <p id="rejdetails"></p>
        <p>ID: <span id="rejid"></span></p>
    </div>

    <div class="accept descision" id="acception">
        <div class="anim">
            <div class="loader"></div>
        </div>
        <div class="top">
            <span id="chkname"></span>
            <span class="lef">Check-In</span>
        </div>
        <img class="inform" src="data:image/svg+xml;base64," alt="accpeted">
        <h1 id="denrl">Checked In</h1>
        <hr>
        <h2 class="personname" id="accname">John Cena</h2>
        <p id="accdetails"></p>
        <p>ID: <span id="accid"></span></p>
    </div>
    <script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>
    <script src="https://unpkg.com/@supabase/supabase-js@2"></script>
    <script>
        const supakey = "<%= locals.supakey %>";
        const supabaseUrl = "<%= locals.supabaseUrl %>";
        const supabaseClient = window.supabase.createClient(supabaseUrl, supakey);

        let scannerpause = false;
        const html5QrCode = new Html5Qrcode("scams");
        const scannerConfig = { fps: 10, qrbox: {width: 250, height: 250} };

        function rejection(MAIN, NAME, DETAILS, ID){
            const rejdiv = document.getElementById('rejection');

            const demnal = document.getElementById('demnal');
            const rejname = document.getElementById('rejname');
            const rejdetails = document.getElementById('rejdetails');
            const rejid = document.getElementById('rejid');
            demnal.innerHTML = MAIN;
            rejname.innerHTML = NAME;
            rejdetails.innerHTML = DETAILS;
            rejid.innerHTML = ID;
            const sound = new Audio('resources/rejec.wav')
            sound.play();
            rejdiv.style.display = "block";
            setTimeout(() =>{
                rejdiv.style.display = "none";
            },5000);
        }
        function accept(MAIN, NAME, DETAILS, ID){
            const accdiv = document.getElementById('acception');

            const denrl = document.getElementById('denrl');
            const accname = document.getElementById('accname');
            const accdetails = document.getElementById('accdetails');
            const accid = document.getElementById('accid');
            denrl.innerHTML = MAIN;
            accname.innerHTML = NAME;
            accdetails.innerHTML = DETAILS;
            accid.innerHTML = ID;
            const sound = new Audio('resources/accep.wav')
            accdiv.style.display = "block";
            sound.play();
            setTimeout(() =>{
                accdiv.style.display = "none";
            },5000);
        }

        async function onScanSuccess(decodedText, decodedResult) {
            if (scannerpause){
                return;
            }
            scannerpause = true;
            setTimeout(() => {
                scannerpause = false;
            }, 5000);

            try{
                if (!decodedText.startsWith("sysco://")){
                    rejection("Error", "Invalid QR code format", "The scanned QR code is not a sysco issued QR Code, and is invalid", "N/A" );
                    return;
                }
                const identity = decodedText.slice("sysco://".length).trim();
                if (!identity){
                    rejection("Error", "Invalid QR code, Malformed Identity", "This scanned QR code is malformed and may be intentionally tampered with, please check the QR code and try again", "N/A");
                    return;
                }
                console.log(identity);
                const username = document.getElementById('username').innerText;
                const {data:ussr, error:usrErr} = await supabaseClient.from('Users').select('*').eq('uuid', identity).single();
                if (usrErr || !ussr){
                    rejection("Error", "User Not Found", "The user associated with this event could not be found, Please check the QR code and try again", "N/A");
                }
                const {data:damel, error:damerr} = await supabaseClient.from('Sessions').select('*').eq('uuid', identity).eq('sessionid', Number(document.getElementById('session').value)).single();
                if (damerr || !damel){
                    rejection("Error", "Session Not Found", "The user is not registered for this session, please check the QR code and try again", "N/A");
                    return;
                }
                if (damel.present){
                    rejection("Already Checked In", ussr.name || "Participant", ussr.extrainfo, damel.identity || identity);
                    return;
                }
                const {data,error} = await supabaseClient.from('Sessions').update({present:true}).eq('uuid', identity).eq('sessionid', Number(document.getElementById('session').value)).select().single();
                if (!document.getElementById('session').value){
                    rejection("Error", "No Session Selected", "Please select a session to check-in a participant", "N/A")
                }
                
                if (error || !data){
                    rejection("Error", "Participant Not Found", "The scanned QR code does not match any participant in your event database, please check the QR code and try again", "N/A");
                    return;
                }

                accept("Checked In", ussr.name || "Participant", ussr.extrainfo, data.identity || identity);

            }catch(err){
                console.error("Unable to process QR code:", err);
            }
        }


    Html5Qrcode.getCameras().then((devices) => {
        if (!devices || devices.length === 0) {
            throw new Error("No camera found");
        }

        const cameraId = devices[0].id;
        return html5QrCode.start(cameraId, scannerConfig, onScanSuccess);
    }).catch((error) => {
        console.error("Unable to start QR scanner:", error);
    });

        const date = new Date();
        var datdentity = document.getElementById('date');
        var months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
        datdentity.innerHTML = "Today: "+date.getDate() + " " + months[date.getMonth()] + " " + date.getFullYear();
    </script>
</body>
</html>