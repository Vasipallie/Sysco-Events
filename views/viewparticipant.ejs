<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Participants | <%= locals.event_name %></title>
    <link rel="stylesheet" href="main.css">
    <link rel="icon" type="image/icon" href="resources/sysco.png">
    <style>
        #scams{
            width: 40em;
            margin: 1rem auto 0;
            border-radius: 1em;
        }
        #scams video{
            transform: scaleX(-1);
            
            border-radius: 1em;
            
        }
        @media (max-width: 40em){
            #scams,
            #scams video{
                width: 100%;
                max-width: 100%;
            }
        }
        .descision{
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background-color: #000a1d;
            padding: 20px;
            width:100%;
            height:100%;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.3);
        }
        .descision h1{
            font-size: 4em;
            margin-bottom: 10px;
        }
        .descision h2{
            font-size: 2.5em;
            margin-bottom: 10px;
        }
        .rej{
            display: none;
            background: linear-gradient(145deg, rgba(255,0,0,1) 0%, rgb(29, 0, 0) 100%);
        }
        .accept{
            display: none;
            background: linear-gradient(145deg, rgb(0, 206, 0) 0%, rgb(0, 29, 0) 100%);
        }
        .inform{
            filter: brightness(0) invert(1);
            width: 100px;
        }
        .anim{
            position: absolute;
            top:0;
            width: 100%;
            height:0.4em;
            padding:0;
            margin:0;
            box-sizing:border-box;
            left:0;
        }
        .loader{
            height:100%;
            background:fixed linear-gradient(90deg,  rgba(255,255,255,0.1)  0%, rgb(255, 255, 255) 100%);
            animation: loading 5s linear infinite;
        }
        @keyframes loading {
            0% { transform: translateX(-100%); }
            100% { transform: translateX(100%); }
        }
        .top{
            display:flex;
            justify-content:space-between;
            width:100%;
            font-size:1.5em;
            color:#E6FDFF;
        }
        select{
            width:20em;
            padding:0.5em;
            font-size:1.2em;
            border-radius:1em;
            background-color:#031A54;
            color:#E6FDFF;
            border:1.5px solid #E6FDFF;
            margin-block:1em;
        }
        a{
            color:#E6FDFF;
            font-size:1.2em;
            line-height:1.5em;
        }
        .dashi{
            display:inline-block;
            text-decoration:none;
            border-radius:0.4em;
            border:1px solid #E6FDFF;
            padding:0.2em 0.4em;
            margin-top:0.4em;
        }
        .particihold{
            display:flex;
            flex-direction:column;
            flex:1;
            padding:0.6em;
            width:100%;
            min-height:0;
        }
        .participant{
            display:grid;
            grid-template-columns:minmax(0, 1fr) auto;
            gap:1em;
            width:100%;
            padding:1em;
            border-radius:0 0.8em 0.8em 0;
            border:1px solid rgba(152, 246, 255, 0.45);
            border-left:0.35em solid #98f6ff;
            background:linear-gradient(135deg, #031A54 0%, #062467 100%);
            box-shadow:0 0.5em 1em rgba(0, 0, 0, 0.22);
            transition:transform 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
        }
        .participant p{
            margin:0.35em 0;
            line-height:1.2em;
        }
        .participant > div:last-child{
            text-align:right;
        }
        .partiname{
            font-size:1.3em;
            font-weight:bold;
            color:#ffffff;
        }
        .partiemail,
        .partiid{
            color:rgba(230, 253, 255, 0.75);
        }
        .participant a{
            display:inline-block;
            margin-top:0.4em;
            padding:0.35em 0.6em;
            border:1px solid rgba(230, 253, 255, 0.65);
            border-radius:0.35em;
            font-size:0.95em;
            text-decoration:none;
            transition:background-color 160ms ease, color 160ms ease;
        }
        .participant a:hover,
        .participant a:focus-visible{
            background-color:#E6FDFF;
            color:#031A54;
            outline:none;
        }
        @media (max-width: 40em){
            .participant{
                grid-template-columns:1fr;
            }
            .participant > div:last-child{
                text-align:left;
            }
        }
        .actions-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1em;
            margin-bottom: 1em;
            flex-wrap: wrap;
        }
        .search-box {
            position: relative;
            flex: 1;
            min-width: 14em;
        }
        .search-box span {
            position: absolute;
            left: 0.8em;
            top: 50%;
            transform: translateY(-50%);
            color: #98f6ff;
            font-size: 1.1em;
            pointer-events: none;
        }
        .search-box input {
            width: 100%;
            padding: 0.6em 0.8em 0.6em 2.4em;
            font-size: 1.1em;
            border-radius: 0.6em;
            background-color: #031A54;
            color: #E6FDFF;
            border: 1.5px solid #E6FDFF;
            font-family: inherit;
            outline: none;
            box-sizing: border-box;
            transition: border-color 160ms ease, box-shadow 160ms ease;
        }
        .search-box input::placeholder {
            color: rgba(230, 253, 255, 0.5);
        }
        .search-box input:focus {
            border-color: #98f6ff;
            box-shadow: 0 0 0 3px rgba(152, 246, 255, 0.25);
        }
        .participant-list {
            display: flex;
            flex-direction: column;
            gap: 0.8em;
            width: 100%;
        }
        .participant-actions {
            display: flex;
            gap: 0.5em;
            justify-content: flex-end;
            flex-wrap: wrap;
        }
        .participant .danger {
            border-color: rgba(255, 120, 120, 0.6);
            color: #ff9e9e;
        }
        .participant .danger:hover,
        .participant .danger:focus-visible {
            background-color: #ff4d4d;
            color: #ffffff;
            border-color: #ff4d4d;
        }
        .partiemail,
        .partiid {
            overflow-wrap: anywhere;
        }
        .empty-msg {
            text-align: center;
            padding: 2em;
            font-size: 1.2em;
            color: rgba(230, 253, 255, 0.75);
        }
    </style>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
</head>
<body>
    <div class="maine">
        <img src="resources/syscot.png" class="infom">
        <hr>
        <h1><%= locals.event_name %></h1>
        <p id="date"></p>
        <a class="dashi" href="/dashboard">Back to Dashboard</a>
    </div>

    <h1 style="text-align: center; margin-top: 0.6em; margin-bottom: 0.2em;">View Participants</h1>
    <p style="text-align: center; margin-bottom: 1em; color: rgba(230, 253, 255, 0.75);">View your participants and manage their information.</p>
    <% if (locals.alert) { %>
        <p style="text-align: center; color: #98f6ff; margin-bottom: 1em;"><%= locals.alert %></p>
    <% } %>

    <div class="particihold">
        <div class="actions-bar">
            <label class="search-box" for="search">
                <span aria-hidden="true" class="fa fa-search"></span>
                <input type="search" id="search" placeholder="Search by name, email, or ID" autocomplete="off">
            </label>
            <a class="dashi" href="/sendall">Send All Tickets</a>
        </div>

        <% if (locals.datea && locals.datea.length > 0) { %>
            <div class="participant-list">
                <% locals.datea.forEach(function(participant) { %>
                    <article class="participant" data-search="<%= `${participant.name} ${participant.email} ${participant.uuid} ${participant.extrainfo || ''}`.toLowerCase() %>">
                        <div>
                            <p class="partiname"><%= participant.name %></p>
                            <p class="partiemail"><%= participant.email %></p>
                            <a href="/sendemail/<%=participant.uuid%>">Send Email</a>
                        </div>
                        <div>
                            <p class="partiid">ID: <%= participant.uuid %></p>
                            <p><strong>Extra information:</strong> <%= participant.extrainfo || 'None' %></p>
                            <div class="participant-actions">
                                <a href="/edit/<%= participant.uuid %>">Edit Participant</a>
                                <a class="danger" href="/remove/<%= participant.uuid %>">Remove</a>
                            </div>
                        </div>
                    </article>
                <% }); %>
            </div>
            <p class="empty-msg" id="no-results" hidden>No participants match your search.</p>
        <% } else { %>
            <p class="empty-msg">No participants found.</p>
        <% } %>
    </div>
    <script src="https://unpkg.com/@supabase/supabase-js@2"></script>
    <script>
        const date = new Date();
        var datdentity = document.getElementById('date');
        var months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
        datdentity.innerHTML = "Today: "+date.getDate() + " " + months[date.getMonth()] + " " + date.getFullYear();

        const search = document.getElementById('search');
        const noResults = document.getElementById('no-results');
        const participants = document.querySelectorAll('.participant');
        search.addEventListener('input', function () {
            const query = search.value.trim().toLowerCase();
            let visibleCount = 0;
            participants.forEach(function (participant) {
                const matches = participant.dataset.search.includes(query);
                participant.hidden = !matches;
                if (matches) visibleCount += 1;
            });
            if (noResults) noResults.hidden = visibleCount !== 0;
        });
    </script>
</body>
</html>