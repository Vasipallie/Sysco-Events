<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="main.css">
    <link rel="icon" type="image/icon" href="resources/sysco.png">
    <style>
        
        select{
            width:20em;
            padding:0.5em;
            font-size:1.2em;
            border-radius:1em;
            background-color:#031A54;
            color:#E6FDFF;
            border:1.5px solid #E6FDFF;
            margin-block:1em;
        }
        a{
            color:#E6FDFF;
            font-size:1.2em;
            line-height:1.5em;
        }
        .dashi{
            display:inline-block;
            text-decoration:none;
            border-radius:0.4em;
            border:1px solid #E6FDFF;
            padding:0.2em 0.4em;
            margin-top:0.4em;
        }
    </style>
</head>
<body>
    <div class="maine">
        <img src="resources/syscot.png" class="infom">
        <hr>
        <span style="display:none;" id="username"><%=locals.username || "N/A"%></span>
        <h1 id="eventname"><%= locals.event_name %></h1>
        <p id="date"></p>
        <a class="dashi" href="/dashboard">Back to Dashboard</a>
    </div>
    <div class="center">
        <h1>Sysco Email</h1>
        <form action="/sendemail" method="POST">
            <label for="recipient">Choose a Recipient:</label>
            <select id="session">
                <option disabled value="--Choose a Session--">--Choose Recipient--</option>
                <%- locals.session %>
            </select>
            <label for="subject">Subject:</label>
            <input type="text" placeholder="Enter a Subject" name="subject" required>
            <label for="message">Message:</label>
        </form>
    </div>
    <script>
        const date = new Date();
        var datdentity = document.getElementById('date');
        var months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
        datdentity.innerHTML = "Today: "+date.getDate() + " " + months[date.getMonth()] + " " + date.getFullYear();
    </script>
</body>
</html>