<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="main.css">
    <link rel="icon" type="image/icon" href="resources/sysco.png">
    <style>
        #scams{
            width: 40em;
            margin: 1rem auto 0;
            border-radius: 1em;
        }
        #scams video{
            transform: scaleX(-1);
            
            border-radius: 1em;
            
        }
        @media (max-width: 40em){
            #scams,
            #scams video{
                width: 100%;
                max-width: 100%;
            }
        }
        .descision{
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background-color: #000a1d;
            padding: 20px;
            width:100%;
            height:100%;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.3);
        }
        .descision h1{
            font-size: 4em;
            margin-bottom: 10px;
        }
        .descision h2{
            font-size: 2.5em;
            margin-bottom: 10px;
        }
        .rej{
            display: none;
            background: linear-gradient(145deg, rgba(255,0,0,1) 0%, rgb(29, 0, 0) 100%);
        }
        .accept{
            display: none;
            background: linear-gradient(145deg, rgb(0, 206, 0) 0%, rgb(0, 29, 0) 100%);
        }
        .inform{
            filter: brightness(0) invert(1);
            width: 100px;
        }
        .anim{
            position: absolute;
            top:0;
            width: 100%;
            height:0.4em;
            padding:0;
            margin:0;
            box-sizing:border-box;
            left:0;
        }
        .loader{
            height:100%;
            background:fixed linear-gradient(90deg,  rgba(255,255,255,0.1)  0%, rgb(255, 255, 255) 100%);
            animation: loading 5s linear infinite;
        }
        @keyframes loading {
            0% { transform: translateX(-100%); }
            100% { transform: translateX(100%); }
        }
        .top{
            display:flex;
            justify-content:space-between;
            width:100%;
            font-size:1.5em;
            color:#E6FDFF;
        }
        select{
            width:20em;
            padding:0.5em;
            font-size:1.2em;
            border-radius:1em;
            background-color:#031A54;
            color:#E6FDFF;
            border:1.5px solid #E6FDFF;
            margin-block:1em;
        }
        a{
            color:#E6FDFF;
            font-size:1.2em;
            line-height:1.5em;
        }
        .dashi{
            display:inline-block;
            text-decoration:none;
            border-radius:0.4em;
            border:1px solid #E6FDFF;
            padding:0.2em 0.4em;
            margin-top:0.4em;
        }
        .personname{
            line-height:1em;
            margin:0;
        }
        #accdetails,#rejdetails{
            font-size:1.5em;
            font-weight: 400;
            line-height:1em;
            margin:0;}
    </style>
</head>
<body>
    <div class="maine">
        <img src="resources/syscot.png" class="infom">
        <hr>
        <span style="display:none;" id="username"><%=locals.username || "N/A"%></span>
        <h1 id="eventname"><%= locals.event_name %></h1>
        <p id="date"></p>
        <a class="dashi" href="/dashboard">Back to Dashboard</a>
    </div>
    <div class="center">
        <h1>Manual Check-In</h1>
        <select id="session" required>
            <option disabled value="--Choose a Session--">--Choose a Session--</option>
            <% (locals.sessions || []).forEach(function(session) { %>
                <option value="<%= session.id %>"><%= session.name %></option>
            <% }); %>
        </select>
        <div id="scams"></div>
    </div>
    <script>
        const date = new Date();
        var datdentity = document.getElementById('date');
        var months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
        datdentity.innerHTML = "Today: "+date.getDate() + " " + months[date.getMonth()] + " " + date.getFullYear();
    </script>
</body>
</html>