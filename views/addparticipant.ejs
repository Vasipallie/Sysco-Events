<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="main.css">
    <link rel="icon" type="image/icon" href="resources/sysco.png">
    <style>
        #scams{
            width: 40em;
            margin: 1rem auto 0;
            border-radius: 1em;
        }
        #scams video{
            transform: scaleX(-1);
            
            border-radius: 1em;
            
        }
        @media (max-width: 40em){
            #scams,
            #scams video{
                width: 100%;
                max-width: 100%;
            }
        }
        .descision{
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background-color: #000a1d;
            padding: 20px;
            width:100%;
            height:100%;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.3);
        }
        .descision h1{
            font-size: 4em;
            margin-bottom: 10px;
        }
        .descision h2{
            font-size: 2.5em;
            margin-bottom: 10px;
        }
        .rej{
            display: none;
            background: linear-gradient(145deg, rgba(255,0,0,1) 0%, rgb(29, 0, 0) 100%);
        }
        .accept{
            display: none;
            background: linear-gradient(145deg, rgb(0, 206, 0) 0%, rgb(0, 29, 0) 100%);
        }
        .inform{
            filter: brightness(0) invert(1);
            width: 100px;
        }
        .anim{
            position: absolute;
            top:0;
            width: 100%;
            height:0.4em;
            padding:0;
            margin:0;
            box-sizing:border-box;
            left:0;
        }
        .loader{
            height:100%;
            background:fixed linear-gradient(90deg,  rgba(255,255,255,0.1)  0%, rgb(255, 255, 255) 100%);
            animation: loading 5s linear infinite;
        }
        @keyframes loading {
            0% { transform: translateX(-100%); }
            100% { transform: translateX(100%); }
        }
        .top{
            display:flex;
            justify-content:space-between;
            width:100%;
            font-size:1.5em;
            color:#E6FDFF;
        }
        select{
            width:20em;
            padding:0.5em;
            font-size:1.2em;
            border-radius:1em;
            background-color:#031A54;
            color:#E6FDFF;
            border:1.5px solid #E6FDFF;
            margin-block:1em;
        }
        a{
            color:#E6FDFF;
            font-size:1.2em;
            line-height:1.5em;
        }
        .dashi{
            display:inline-block;
            text-decoration:none;
            border-radius:0.4em;
            border:1px solid #E6FDFF;
            padding:0.2em 0.4em;
            margin-top:0.4em;
        }
        .particihold{
            display:flex;
            flex-direction:column;
            flex:1;
            padding:0.6em;
            width:100%;
            min-height:0;
        }
        .participant{
            display:grid;
            grid-template-columns:minmax(0, 1fr) auto;
            gap:1em;
            width:100%;
            padding:1em;
            border-radius:0 0.8em 0.8em 0;
            border:1px solid rgba(152, 246, 255, 0.45);
            border-left:0.35em solid #98f6ff;
            background:linear-gradient(135deg, #031A54 0%, #062467 100%);
            box-shadow:0 0.5em 1em rgba(0, 0, 0, 0.22);
            transition:transform 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
        }
        .participant p{
            margin:0.35em 0;
            line-height:1.2em;
        }
        .participant > div:last-child{
            text-align:right;
        }
        .partiname{
            font-size:1.3em;
            font-weight:bold;
            color:#ffffff;
        }
        .partiemail,
        .partiid{
            color:rgba(230, 253, 255, 0.75);
        }
        .participant a{
            display:inline-block;
            margin-top:0.4em;
            padding:0.35em 0.6em;
            border:1px solid rgba(230, 253, 255, 0.65);
            border-radius:0.35em;
            font-size:0.95em;
            text-decoration:none;
            transition:background-color 160ms ease, color 160ms ease;
        }
        .participant a:hover,
        .participant a:focus-visible{
            background-color:#E6FDFF;
            color:#031A54;
            outline:none;
        }
        @media (max-width: 40em){
            .participant{
                grid-template-columns:1fr;
            }
            .participant > div:last-child{
                text-align:left;
            }
        }
    </style>
</head>
<body>
    <div class="maine">
        <img src="resources/syscot.png" class="infom">
        <hr>
        <h1><%= locals.event_name %></h1>
        <p id="date"></p>
        <a class="dashi" href="/dashboard">Back to Dashboard</a>
    </div>
    <h1 style="text-align: center;">Add Participants</h1>
    <div class="particihold">
        
    </div>
    <script src="https://unpkg.com/@supabase/supabase-js@2"></script>
    <script>
        const date = new Date();
        var datdentity = document.getElementById('date');
        var months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
        datdentity.innerHTML = "Today: "+date.getDate() + " " + months[date.getMonth()] + " " + date.getFullYear();
    </script>
</body>
</html>